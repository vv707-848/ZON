# Zon agents service — copy to .env. Runs on the app node, 127.0.0.1 only; Laravel is its only caller.
HOST=127.0.0.1
PORT=8100
LOG_LEVEL=INFO

# Shared with backend/.env (same names). `openssl rand -hex 32` for each.
AGENTS_INTERNAL_KEY=
INDEX_SHARED_SECRET=
INDEX_MAX_SKEW_SECONDS=300
INDEX_STATE_PATH=var/index_state.sqlite3

# The AI node's engine (SGLang or vLLM), local here through the SSH tunnel (deploy/ai-node). Same key as LLM_API_KEY of
# the Pod. LLM_PROFILE is the model it serves (zon_agents/models/<profile>.toml) — the same name as ZON_PROFILE there.
LLM_BASE_URL=http://127.0.0.1:30000/v1
LLM_API_KEY=
LLM_MODEL=zon-ai
LLM_PROFILE=qwen3.6-35b-a3b-escha-w2
LLM_MAX_CONCURRENCY=8
REQUEST_BUDGET_SECONDS=15

# bge-m3 embedding server, through the tunnel (the Pod's 8080 arrives here on 18080; 8080 is Reverb).
EMBED_URL=http://127.0.0.1:18080
EMBED_TIMEOUT_SECONDS=5

# Qdrant 1.20 on the data node — private address, API key required (QDRANT__SERVICE__API_KEY there).
QDRANT_URL=http://10.10.0.20:6333
QDRANT_API_KEY=
COLBERT_ENABLED=true
TURBO_BITS=bits4
HYBRID_PREFETCH_LIMIT=100

KNOWLEDGE_TOP_K=5
KNOWLEDGE_MIN_SCORE=0.45

# Error tracking (Sentry project «zon-agents»; zon_agents/monitoring.py). Empty = nothing is sent. The deploy sets
# the release to the commit. 0 = errors only; 0.05 also samples 5% of calls as performance traces.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
