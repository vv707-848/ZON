# ── The app ────────────────────────────────────────────────────────────────────────────────────────────
APP_NAME=Zon
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.zon.sa
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA
LOG_CHANNEL=daily
LOG_LEVEL=info

# The app's deep links («مشاركة»): {base}/listings/{id}
# The website's address: shared links (/listings/{id}…) and the website itself (routes/site.php answer on its host only)
ZON_DEEP_LINK_BASE=https://zon.sa
# HMAC key of device / IP fingerprints and AI quota counters (long random string)
RATE_SALT=
# Comma-separated IPs allowed into /admin (empty = everyone; zon:doctor warns in production)
ADMIN_ALLOWED_IPS=
# Development only, with SMS_DRIVER=fake: a fixed verification code (the app's 204815). Leave empty in production.
OTP_TEST_CODE=

# ── Data node (10.10.0.20) ──────────────────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=10.10.0.20
DB_PORT=3306
DB_DATABASE=zone
DB_USERNAME=zon
DB_PASSWORD=
# The SuperAgent's read-only user (deploy/mysql/ai_reader.sql): SELECT on the ai_v_* views only
REPORT_DB_USERNAME=ai_reader
REPORT_DB_PASSWORD=

# ── Redis-compatible (Dragonfly) on the app node ────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUOTA_DB=2
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true

# ── Media (MinIO on the app node; served through https://media.zon.sa) ─────────────────────────────────
MEDIA_DISK=minio
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_PUBLIC_URL=https://media.zon.sa
MINIO_BUCKET=zon-media
MINIO_KEY=
MINIO_SECRET=

# ── Live messaging (Reverb behind nginx /app/) ──────────────────────────────────────────────────────────
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=api.zon.sa
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080

# ── The AI layer (agents service on 127.0.0.1:8100 — agents/.env must hold the same two secrets) ────────
AGENTS_URL=http://127.0.0.1:8100
AGENTS_INTERNAL_KEY=
INDEX_SHARED_SECRET=

# ── Integrations: fake = simulation. In production a fake driver is refused unless listed here ───────────
# REGA and Nafath have no live driver yet. Listing them (rega,nafath) lets production run on their simulation:
# licence numbers are then NOT checked with REGA and the Nafath badge is NOT a real verification — the owner's
# decision before any public launch (docs/integrations.md). zon:doctor reports every simulation it finds.
PRODUCTION_ALLOWS_FAKE=
SMS_DRIVER=taqnyat
TAQNYAT_TOKEN=
TAQNYAT_SENDER=ZON
REGA_DRIVER=fake
NAFATH_DRIVER=fake
PAYMENTS_DRIVER=moyasar
MOYASAR_SECRET_KEY=
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_WEBHOOK_SECRET=
APP_STORE_DRIVER=apple
APP_STORE_ISSUER_ID=
APP_STORE_KEY_ID=
APP_STORE_PRIVATE_KEY=/etc/zon/app-store-key.p8
APP_STORE_BUNDLE_ID=com.zon.app
GOOGLE_PLAY_DRIVER=google
GOOGLE_PLAY_PACKAGE=com.zon.app
GOOGLE_PLAY_CREDENTIALS=/etc/zon/google-play-service-account.json
STORE_NOTICES_KEY=
PUSH_DRIVER=fcm
FCM_PROJECT_ID=
FCM_CREDENTIALS=/etc/zon/fcm-service-account.json
INVOICING_DRIVER=local
IMAGE_HASH_DRIVER=agents

# Links that open the app (served at zon.sa/.well-known/ once set; docs/website.md)
APPLE_TEAM_ID=
ANDROID_CERT_SHA256=
# Photos above this many megapixels are refused before decoding (deploy/php/zon.ini sets memory_limit=256M)
MEDIA_MAX_MEGAPIXELS=36
