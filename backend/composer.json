{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "zon/backend",
    "type": "project",
    "description": "Zon real-estate platform: the mobile app's API, the admin panel and the AI gateway.",
    "license": "proprietary",
    "require": {
        "php": "^8.5",
        "brick/math": "^1.0",
        "filament/filament": "^5.11",
        "guzzlehttp/guzzle": "^7.10",
        "laravel/framework": "^13.39",
        "laravel/reverb": "^1.12",
        "laravel/sanctum": "^4.3",
        "league/flysystem-aws-s3-v3": "^3.35",
        "spatie/laravel-activitylog": "^5.1",
        "spatie/laravel-permission": "^8.3"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.32",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9",
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan filament:upgrade"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": false,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
