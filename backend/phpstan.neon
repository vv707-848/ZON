includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - app
        - database
        - routes
        - config
        # The tests too: a test calling a method that no longer exists fails here, not only when it runs.
        - tests
    parseModelCastsMethod: true
    treatPhpDocTypesAsCertain: false
